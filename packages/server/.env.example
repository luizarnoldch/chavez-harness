# Host-side URL (tools / drizzle-kit from the host against published port 28000)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:28000/app
NODE_ENV=development

# Pública (prod: https://api.example.com)
SERVER_URL=http://localhost:28001
# Bind del proceso (en compose interno puede ser 3000; en host publicado 28001)
# Nota: el contenedor chavez-server publica 28001. Si Compose está up, `bun run dev`
# local en este puerto falla con EADDRINUSE — usa solo el CLI, o `docker:down` / stop server antes.
PORT=28001

# Postgres (docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=28000

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Opcional; si se omite, = SERVER_URL
# BETTER_AUTH_URL=http://localhost:28001

# CLI (run on host, not in compose) — debe coincidir con SERVER_URL:
CHAVEZ_API_URL=http://localhost:28001

# Docs (non-production): GET /docs (Swagger UI), GET /openapi.json
# E2E HTTP (server must be up): bun run e2e:bruno
