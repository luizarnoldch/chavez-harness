meta {
  name: Sign up email
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const email = `e2e-${Date.now()}@example.com`;
  bru.setEnvVar("email", email);
}

body:json {
  {
    "name": "E2E User",
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
}
