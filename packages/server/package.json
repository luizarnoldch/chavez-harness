{
  "name": "@chavez-harness/server",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "e2e:bruno": "cd bruno && bru run -r --env local --sandbox=developer --disable-cookies",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:seed": "bun run ./src/db/scripts/seed.ts",
    "db:reset": "bun run ./src/db/scripts/reset.ts",
    "auth:generate": "bunx auth@latest generate --config ./src/lib/auth/index.ts --output ./src/db/auth/auth-schema.ts -y"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "^8.23.1",
    "@usebruno/cli": "^4.1.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@chavez-harness/shared": "workspace:*",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.5",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "type": "module"
}
