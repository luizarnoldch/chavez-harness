---
import Layout from "@/layouts/Layout.astro";
import AuthLayout from "@/features/auth/AuthLayout.astro";
import { SignInForm } from "@/features/auth/SignInForm";

const next = Astro.url.searchParams.get("next") ?? "/";
---

<Layout title="Iniciar sesión · Chavez">
  <AuthLayout heading="Bienvenido" lede="Workspaces y chat sincronizados con el TUI.">
    <SignInForm client:load redirectTo={next} />
  </AuthLayout>
</Layout>
